---
import { APORTES, TIPOS } from '@/data/proyectos';
---

<div id="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle" hidden>
  <div class="sheet">
    <header>
      <h3 id="mTitle">Agregar proyecto</h3>
      <button type="button" id="mClose">Cerrar (Esc)</button>
    </header>

    <div class="body">
      <div class="f" id="f-nombre">
        <label for="p-nombre">Nombre de la obra <span class="req">*</span></label>
        <input id="p-nombre" type="text" placeholder="Ej.: Torre Icono" />
        <div class="err"></div>
      </div>

      <div class="row2">
        <div class="f" id="f-tipo">
          <label for="p-tipo">Tipo de obra <span class="req">*</span></label>
          <select id="p-tipo">
            <option value="">Selecciona</option>
            {TIPOS.map((tipo) => <option value={tipo}>{tipo}</option>)}
          </select>
          <div class="err"></div>
        </div>

        <div class="f" id="f-anio">
          <label for="p-anio">Año <span class="req">*</span></label>
          <input id="p-anio" type="number" min="1990" max="2035" placeholder="2026" />
          <div class="err"></div>
        </div>
      </div>

      <div class="f" id="f-ubicacion">
        <label for="p-ubi">Ubicación <span class="req">*</span></label>
        <input id="p-ubi" type="text" placeholder="Ej.: Punta Cana, La Altagracia" />
        <div class="err"></div>
      </div>

      <div class="f">
        <label>Aporte de Flernil</label>
        <div class="checks" id="p-aportes">
          {
            APORTES.map((aporte) => (
              <label>
                <input type="checkbox" value={aporte} />
                {aporte}
              </label>
            ))
          }
        </div>
      </div>

      <div class="f">
        <label for="p-desc">Descripción</label>
        <textarea id="p-desc" maxlength="300" placeholder="Hasta 300 caracteres"></textarea>
        <div class="hint"><span id="cnt">0</span>/300 caracteres</div>
      </div>

      <div class="f" id="f-imagen">
        <label for="p-foto">Foto de portada <span class="req">*</span></label>
        <div class="drop">
          <img class="prev" id="p-prev" alt="" />
          <div>
            <input id="p-foto" type="file" accept="image/*" />
            <div class="hint">
              Hasta 5 MB. Se optimiza automáticamente: no hace falta editarla antes.
            </div>
          </div>
        </div>
        <div class="err"></div>
      </div>

      <div class="row2">
        <div class="f">
          <label for="p-estado">Estado</label>
          <select id="p-estado">
            <option value="publicado">Publicado</option>
            <option value="oculto">Oculto</option>
          </select>
        </div>

        <div class="f">
          <label for="p-dest">Destacado</label>
          <select id="p-dest">
            <option value="no">No</option>
            <option value="si">Sí, fijar arriba</option>
          </select>
          <div class="hint">Máximo 3 obras destacadas.</div>
        </div>
      </div>

      <p class="aviso" id="mAviso" role="alert" hidden></p>
    </div>

    <footer>
      <button class="btn ghost claro" type="button" id="mCancel">Cancelar</button>
      <button class="btn dark" type="button" id="mSave">Publicar proyecto</button>
    </footer>
  </div>
</div>
