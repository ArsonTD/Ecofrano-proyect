---
import Logo from '@/assets/logo.svg';
import { EMPRESA } from '@/data/sitio';
import { TIPOS, publicados } from '@/data/proyectos';

const obras = publicados();

/** Las mismas categorías que filtran la galería, con su conteo. */
const CATEGORIAS = TIPOS.map((tipo) => ({
  tipo,
  cuenta: obras.filter((p) => p.tipo === tipo).length,
}));
---

<header id="nav">
  <div class="wrap">
    <a class="logo" href="#inicio">
      <Logo class="mark" aria-hidden="true" />
      <b>{EMPRESA.nombre}<span>SRL · desde {EMPRESA.desde}</span></b>
    </a>

    <button id="burger" type="button" aria-expanded="false" aria-controls="menu">Menú</button>

    <nav id="menu" aria-label="Navegación principal">
      <a href="#servicios">Servicios</a>
      <a href="#nosotros">Nosotros</a>

      <div class="con-menu">
        <a href="#proyectos">Proyectos</a>
        <div class="submenu">
          {
            CATEGORIAS.map(({ tipo, cuenta }) => (
              <a href="#proyectos" data-tipo={tipo}>
                {tipo}
                <span class="n">{cuenta}</span>
              </a>
            ))
          }
        </div>
      </div>

      <a href="#contacto">Contacto</a>
    </nav>

    <a class="wa" href={EMPRESA.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
  </div>
</header>

<script>
  const nav = document.getElementById('nav')!;
  const menu = document.getElementById('menu')!;
  const burger = document.getElementById('burger')!;

  burger.addEventListener('click', () => {
    const abierto = menu.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(abierto));
  });

  // Al elegir una sección en móvil, el menú se cierra solo.
  menu.addEventListener('click', (e) => {
    const enlace = (e.target as HTMLElement).closest('a');
    if (!enlace) return;

    menu.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');

    // Las categorías del submenú aprietan el botón de filtro que ya tiene la
    // galería, así que el filtro vive en un solo sitio. El salto a #proyectos
    // lo hace el propio enlace.
    const tipo = (enlace as HTMLElement).dataset.tipo;
    if (tipo) {
      document.querySelector<HTMLButtonElement>(`#chips .chip[data-tipo="${tipo}"]`)?.click();
    }
  });

  const alDesplazar = () => nav.classList.toggle('solid', window.scrollY > 40);
  document.addEventListener('scroll', alDesplazar, { passive: true });
  alDesplazar();

  // Marca en el menú la sección que ocupa el centro de la pantalla. Solo los
  // enlaces de primer nivel: los del submenú apuntan todos a #proyectos.
  const enlaces = [...menu.querySelectorAll(':scope > a, :scope > .con-menu > a')];
  const observador = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        const destino = `#${entrada.target.id}`;
        enlaces.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === destino));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );

  for (const id of ['servicios', 'nosotros', 'proyectos', 'contacto']) {
    const seccion = document.getElementById(id);
    if (seccion) observador.observe(seccion);
  }
</script>
