---
import { Image } from 'astro:assets';
import hero from '@/assets/hero.webp';
import { ANIOS, EMPRESA } from '@/data/sitio';
import { SERVICIOS } from '@/data/servicios';
import { publicados } from '@/data/proyectos';

const DOSIER = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/dosier-encofrado-flernil.pdf`;

const DATOS = [
  [`+${ANIOS}`, 'Años en obra'],
  [String(publicados().length), 'Obras entregadas'],
  [String(SERVICIOS.length), 'Servicios'],
  ['360°', 'Encofrado y logística'],
];
---

<section class="hero" id="inicio">
  <div class="hero-img">
    <Image
      src={hero}
      alt="Personal de Encofrado Flernil en obra"
      widths={[720, 1200, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wrap hero-in">
    <p class="eyebrow claro">+{ANIOS} años · República Dominicana</p>
    <h1>Encofrado, andamios y terminación <em>para obras que no pueden parar</em></h1>
    <p>
      Montamos el encofrado, ponemos el andamio, movemos el material y entregamos
      la terminación. Personal propio, equipo disponible y respuesta en {EMPRESA.plazo}.
    </p>

    <div class="hero-cta">
      <a class="btn primary" href="#contacto">Solicitar cotización</a>
      <a class="btn ghost" href={EMPRESA.telefonoHref}>Llamar {EMPRESA.telefono}</a>
      <a
        class="btn ghost chico"
        href={DOSIER}
        download
        type="application/pdf"
        title="Dosier de Encofrado Flernil en PDF (17 MB)"
      >
        <svg class="ico" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 1v8.6M4.4 6.4 8 10l3.6-3.6M1.8 12.6V14h12.4v-1.4" />
        </svg>
        Descargar dosier
      </a>
    </div>

    <div class="facts">
      {
        DATOS.map(([valor, etiqueta]) => (
          <div>
            <div class="n">{valor}</div>
            <div class="l">{etiqueta}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  /**
   * Los números del banner cuentan desde cero al cargar la página.
   *
   * El valor final ya viene escrito desde el build, así que sin JavaScript —o
   * con la animación desactivada por accesibilidad— se ve igual, solo que quieto.
   */

  const DURACION = 1400;
  const ESCALON = 110; // cada número arranca un poco después que el anterior

  interface Cuenta {
    nodo: HTMLElement;
    /** Lo que va antes y después de la cifra: «+19», «360°». */
    antes: string;
    hasta: number;
    despues: string;
  }

  const cuentas = [...document.querySelectorAll<HTMLElement>('.facts .n')]
    .map((nodo) => {
      const partes = /^(\D*)(\d+)(\D*)$/.exec(nodo.textContent?.trim() ?? '');
      return partes
        ? { nodo, antes: partes[1], hasta: Number(partes[2]), despues: partes[3] }
        : null;
    })
    .filter((c): c is Cuenta => c !== null);

  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const facts = document.querySelector('.facts');

  if (cuentas.length && facts && !quieto) {
    const escribir = (c: Cuenta, valor: number) => {
      c.nodo.textContent = `${c.antes}${valor}${c.despues}`;
    };

    // A cero antes del primer pintado, para que no se vea el salto.
    for (const c of cuentas) escribir(c, 0);

    const contar = (c: Cuenta, retraso: number) => {
      const arranque = performance.now() + retraso;
      const paso = (ahora: number) => {
        const t = Math.min(Math.max((ahora - arranque) / DURACION, 0), 1);
        const suave = 1 - (1 - t) ** 3; // rápido al principio, frena al final
        escribir(c, Math.round(c.hasta * suave));
        if (t < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };

    // Arranca sola al cargar, porque el banner se ve de entrada. El observador
    // está por si se entra directo a otra sección (…/#contacto): entonces la
    // cuenta espera a que el banner aparezca en pantalla.
    const observador = new IntersectionObserver(
      (entradas, obs) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        obs.disconnect();
        cuentas.forEach((c, i) => contar(c, i * ESCALON));
      },
      { threshold: 0.2 },
    );
    observador.observe(facts);
  }
</script>
