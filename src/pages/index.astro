---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import Servicios from '@/components/Servicios.astro';
import Nosotros from '@/components/Nosotros.astro';
import Proyectos from '@/components/Proyectos.astro';
import Contacto from '@/components/Contacto.astro';
import Footer from '@/components/Footer.astro';
import { EMPRESA } from '@/data/sitio';
---

<Layout
  titulo={`${EMPRESA.razonSocial} — Encofrado, andamios y terminación en República Dominicana`}
  descripcion="Encofrado, andamios metálicos, alquiler de madera, casetones, acarreo y terminación de obra en toda República Dominicana. Personal propio y respuesta en menos de 24 horas."
>
  <Nav />

  <main id="contenido">
    <Hero />
    <Servicios />
    <Nosotros />
    <Proyectos />
    <Contacto />
  </main>

  <Footer />
</Layout>
